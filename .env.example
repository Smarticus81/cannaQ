# Copy to .env at the repository root. Never commit real credentials.
NODE_ENV=development
PORT=3001
# Use a resolved public URL locally; Railway ${{...}} references work only there.
DATABASE_URL=postgresql://cannaq:cannaq@localhost:5432/cannaq
DATABASE_POOL_MAX=30

# Use keys from the same Clerk development instance.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
BOOTSTRAP_ADMIN_EMAILS=

# Optional AI functionality. Existing integration variable names are supported.
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional digest email delivery.
RESEND_API_KEY=

# Optional Metrc integration. Facility settings can also hold the connection.
METRC_BASE_URL=https://sandbox-api-mi.metrc.com
METRC_VENDOR_KEY=
METRC_USER_KEY=
METRC_LICENSE_NUMBER=
METRC_WRITE_ENABLED=false

# Optional machine access; resolves to an existing active application user.
SERVICE_API_TOKEN=
SERVICE_API_USER_EMAIL=
