# Normalize text files to LF in the repo. Working trees on Windows still
# check out as CRLF when core.autocrlf=true is set; macOS / Linux see LF.
# Without this, the Linux sandbox and GitHub Desktop on Windows disagree
# about how many files are "modified" (the phantom ~400-file diff noted in
# the 13 May AM MTR).

*           text=auto eol=lf

# Source — explicit LF for cross-platform tooling.
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf

# Windows-only scripts should keep CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Lockfiles — leave as-is, generated by tooling.
package-lock.json   text eol=lf -diff
pnpm-lock.yaml      text eol=lf -diff
yarn.lock           text eol=lf -diff

# Binary assets — never normalize.
*.docx      binary
*.xlsx      binary
*.pdf       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       text eol=lf
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.zip       binary
*.gz        binary
*.tar       binary
